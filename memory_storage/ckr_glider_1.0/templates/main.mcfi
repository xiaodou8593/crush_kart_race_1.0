#$(module_prefix)main
# $(module_prefix)tick调用
# 输入vve:vehicle{...}
# 输入<shift_cnt,int>
# 实体对象主程序

execute if score shift_cnt int matches 1.. run return run function $(module_prefix)_del

function $(module_prefix)_get
scoreboard players operation temp_state int = control_active int
execute if score temp_state int matches ..0 run function $(module_prefix)opening
execute if score temp_state int matches 1.. run function $(module_prefix)controlling
function $(module_prefix)_store