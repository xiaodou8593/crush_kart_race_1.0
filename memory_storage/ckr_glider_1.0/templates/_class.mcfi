#$(module_prefix)_class
# 生成预设静态数据模板

function $(module_prefix)_zero
scoreboard players set vve_euler_b int 6
scoreboard players set vve_euler_vmax int 150000
scoreboard players set target_theta int -2147483648
scoreboard players set control_active int -10
function $(module_prefix)_model
data modify storage $(project_name):class $(module_name)_plate set from storage $(project_name):io result